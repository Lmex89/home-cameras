server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Resolve the backend through Docker DNS at request time. This keeps
    # nginx startable during container recreation and DNS registration races.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    location /api/ {
        set $cameras_upstream http://cameras:${CAMERAS_PORT};
        proxy_pass $cameras_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 1800s;
    }

    location /snapshots/ {
        set $cameras_upstream http://cameras:${CAMERAS_PORT};
        proxy_pass $cameras_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
